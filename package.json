{
  "name": "web-games",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "games/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "catalog:generate": "node tooling/generate-catalog/index.mjs",
    "dev": "npm run catalog:generate && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "dev:all": "turbo run dev --parallel",
    "build": "npm run games:build && npm run catalog:generate && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "pages:prepare": "node tooling/cloudflare-pages/prepare.mjs",
    "pages:deploy": "npm run build && npm run pages:prepare && WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler pages deploy .wrangler/pages --project-name web-games --branch main",
    "games:build": "npm run build --workspaces --if-present",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run typecheck && npm run build && node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "lint": "eslint app packages games tooling tests --ignore-pattern public/games --ignore-pattern dist --ignore-pattern .next",
    "game:new": "node tooling/create-game/index.mjs",
    "game:dev": "node tooling/create-game/run-game.mjs dev",
    "game:build": "node tooling/create-game/run-game.mjs build",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@web-games/game-catalog": "*",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "turbo": "2.5.6",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
